{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/postinstall.js",
            "if": "Bash(git push *)",
            "timeout": 30,
            "statusMessage": "Syncing skills to ~/.claude..."
          }
        ]
      }
    ]
  }
}
